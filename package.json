{
  "name": "test-cli",
  "version": "0.1.0",
  "private": true,
  "description": "test-cli AWS SAM app generated by slskit",
  "scripts": {
    "build": "node init && sam build",
    "deploy": "sam deploy --guided",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e .env.dev -- prisma generate",
    "prisma:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.dev -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.dev -- prisma studio",
    "generate:ecommerce": "bash scripts/generate-ecommerce-functions.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "dotenv": "^8.2.0",
    "esbuild": "^0.25.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/aws-lambda": "^8.10.145",
    "prisma": "^6.5.0",
    "dotenv-cli": "^8.0.0"
  }
}
